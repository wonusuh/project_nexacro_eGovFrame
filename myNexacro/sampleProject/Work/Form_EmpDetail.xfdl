<?xml version="1.0" encoding="utf-8"?>
<FDL version="2.1">
  <Form id="Form_Emp" width="1000" height="670" titletext="New Form" onload="form_onload">
    <Layouts>
      <Layout height="670" mobileorientation="landscape" width="1000">
        <Div id="div_detail" taborder="7" text="Div00" left="10" top="10" width="850" height="350" border="1px solid #9c9c9c">
          <Layouts>
            <Layout>
              <Static id="Static00" taborder="0" text="Name" left="20" top="20" width="100" height="30"/>
              <Static id="Static00_00" taborder="1" text="Department" left="20" top="69" width="100" height="30" onclick="div_detail_Static00_00_onclick"/>
              <Static id="Static00_01" taborder="2" text="Salary" left="20" top="119" width="100" height="30"/>
              <Static id="Static00_02" taborder="3" text="Position" left="20" top="202" width="100" height="30" onclick="div_detail_Static00_02_onclick"/>
              <Static id="Static00_03" taborder="4" text="Hobby" left="20" top="279" width="100" height="30" onclick="div_detail_Static00_03_onclick"/>
              <Static id="Static00_04" taborder="5" text="Skill" left="400" top="279" width="100" height="30"/>
              <Static id="Static00_05" taborder="6" text="Memo" left="400" top="202" width="100" height="30" onclick="div_detail_Static00_05_onclick" onchanged="Common_onchanged"/>
              <Static id="Static00_06" taborder="7" text="Gender" left="400" top="119" width="100" height="30" onclick="div_detail_Static00_06_onclick"/>
              <Static id="Static00_07" taborder="8" text="Hire Date" left="400" top="69" width="100" height="30" onclick="div_detail_Static00_07_onclick"/>
              <Static id="Static00_08" taborder="9" text="Emp ID" left="400" top="20" width="100" height="30" onclick="div_detail_Static00_08_onclick"/>
              <Edit id="edt_name" taborder="10" left="150" top="20" width="200" height="30"/>
              <MaskEdit id="msk_empId" taborder="11" left="491" top="20" width="178" height="30" format="AA-###" type="string"/>
              <Combo id="cbo_dept" taborder="12" text="Combo00" left="150" top="69" width="200" height="30" innerdataset="ds_dept" codecolumn="DEPT_CODE" datacolumn="DEPT_NAME"/>
              <Calendar id="cal_hireDate" taborder="13" left="491" top="69" width="149" height="30"/>
              <MaskEdit id="msk_salary" taborder="14" left="150" top="119" width="200" height="30" format="#,#"/>
              <Radio id="rdo_gender" taborder="15" left="491" top="119" width="181" height="30" rowcount="1" innerdataset="innerdataset" codecolumn="codecolumn" datacolumn="datacolumn">
                <Dataset id="innerdataset">
                  <ColumnInfo>
                    <Column id="codecolumn" size="256"/>
                    <Column id="datacolumn" size="256"/>
                  </ColumnInfo>
                  <Rows>
                    <Row>
                      <Col id="codecolumn">A</Col>
                      <Col id="datacolumn">All</Col>
                    </Row>
                    <Row>
                      <Col id="codecolumn">F</Col>
                      <Col id="datacolumn">Female</Col>
                    </Row>
                    <Row>
                      <Col id="codecolumn">M</Col>
                      <Col id="datacolumn">Male</Col>
                    </Row>
                  </Rows>
                </Dataset>
              </Radio>
              <CheckBox id="chk_married" taborder="16" text="Marital Status" left="701" top="119" width="131" height="30"/>
              <ListBox id="lst_pos" taborder="17" left="150" top="180" width="200" height="75" innerdataset="ds_pos" codecolumn="CODE" datacolumn="NAME"/>
              <TextArea id="txt_memo" taborder="18" left="491" top="180" width="142" height="75" onchanged="Common_onchanged"/>
              <MultiCombo id="mcbo_hobby" taborder="19" text="MultiCombo00" left="150" top="257" width="200" height="75" innerdataset="ds_hobby" codecolumn="CODE" datacolumn="NAME" edittype="multitag"/>
              <CheckBoxSet id="chsk_skill" taborder="20" left="491" top="257" width="151" height="75" innerdataset="ds_skill" codecolumn="CODE" datacolumn="NAME" rowcount="3"/>
            </Layout>
          </Layouts>
        </Div>
      </Layout>
    </Layouts>
    <Script type="xscript5.1"><![CDATA[this.fv_empid = '';

// 화면이 모두 로딩된 후 발생하는 이벤트 
this.form_onload = function(obj:nexacro.Form,e:nexacro.LoadEventInfo)
{
	this.transaction(
		'svcSelectCode',
		'http://localhost:8080/edu-egov/edu/getCode.do',
		'',
		'ds_dept=out_dept ds_pos=out_pos ds_skill=out_skill ds_hobby=out_hobby',
		'fn_callback'
	);
};

// 서비스호출 콜백함수
this.fn_callback = (svcId, errCd, errMSg) => {
	//
};
]]></Script>
