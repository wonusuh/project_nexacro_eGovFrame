<?xml version="1.0" encoding="utf-8"?>
<FDL version="2.1">
  <Form id="Form_Postcode" width="750" height="500" titletext="New Form" onload="Form_Postcode_onload">
    <Layouts>
      <Layout height="500" mobileorientation="landscape" width="750">
        <Static id="Static00" taborder="0" text="우편번호" left="10" top="10" width="70" height="30"/>
        <Static id="Static00_00" taborder="1" text="주소" left="10" top="46" width="70" height="30"/>
        <Static id="Static00_01" taborder="2" text="상세주소" left="10" top="82" width="70" height="30" onclick="Common_onclick"/>
        <Static id="Static00_02" taborder="3" text="참고항목" left="10" top="118" width="70" height="30"/>
        <Edit id="edt_post" taborder="4" left="70" top="10" width="120" height="30"/>
        <Button id="btn_post" taborder="5" text="우편번호 찾기" left="200" top="10" width="100" height="30" onclick="btn_post_onclick"/>
        <Edit id="edt_addr1" taborder="6" left="70" top="46" width="416" height="30"/>
        <Edit id="edt_addr2" taborder="8" left="70" top="82" width="416" height="30" onclick="Common_onclick"/>
        <Edit id="edt_desc" taborder="7" left="70" top="118" width="416" height="30"/>
        <WebView id="WebView00" taborder="9" left="186" top="167" width="190" height="72" onusernotify="WebView00_onusernotify"/>
      </Layout>
    </Layouts>
    <Script type="xscript5.1"><![CDATA[// init 함수
this.Form_Postcode_onload = function(obj:nexacro.Form,e:nexacro.LoadEventInfo)
{
	this.WebView00.url = "http://localhost:8080/edu-egov/SearchPost.html";
};

// 우편번호 찾기
this.btn_post_onclick = function(obj:nexacro.Button,e:nexacro.ClickEventInfo)
{
	let param = this.edt_addr1.value;
	if(typeof param === "undefined" || !param) param = "";
	this.WebView00.callScript(`sample6_execDaumPostcode('${param}')`);
};

this.WebView00_onusernotify = function(obj:nexacro.WebView,e:nexacro.WebUserNotifyEventInfo)
{
	const arrAddr = e.userdata.split("||");
	this.edt_post.value = arrAddr[0];
	this.edt_addr1.value = arrAddr[1];
	this.edt_desc.value = arrAddr[2];
	this.edt_addr2.setFocus();
};
]]></Script>
  </Form>
</FDL>
